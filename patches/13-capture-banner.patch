+                if #available(macOS 13, *) { return NSItemProvider(object: image) }
+                // NSImage provides itself from macOS 13; before, its TIFF data.
+                return NSItemProvider(
+                    item: image.tiffRepresentation as NSData?, typeIdentifier: NSPasteboard.PasteboardType.tiff.rawValue)
             } preview: {
                 Image(nsImage: image).resizable().scaledToFit().frame(width: 160, height: 160)
             }
@@ -279,14 +291,14 @@ private struct CaptureBannerThumbnail: View {
