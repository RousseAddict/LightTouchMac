The catalog copy sheet on macOS 11: sizingOptions (macOS 13) is set only where it exists, as macOS 11's hosting
controller sizes its sheet to the content as it changes; Cancel has no role (macOS 12), Escape being its keyboard
shortcut either way.

diff --git a/LightTouchMac/UI/CatalogDetailsViewController.swift b/LightTouchMac/UI/CatalogDetailsViewController.swift
index b87da18c..c50a3f25 100644
--- a/LightTouchMac/UI/CatalogDetailsViewController.swift
+++ b/LightTouchMac/UI/CatalogDetailsViewController.swift
@@ -26,7 +26,8 @@ final class CatalogDetailsViewController: NSHostingController<CatalogDetailsView
             install: install
         )
         super.init(rootView: CatalogDetailsView(model: model))
-        sizingOptions = .preferredContentSize
+        // macOS 11's hosting controller sizes its sheet to the content as it changes.
+        if #available(macOS 13, *) { sizingOptions = .preferredContentSize }
         model.close = { [weak self] in self.map { $0.dismiss($0) } }
     }
     @MainActor required dynamic init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
@@ -67,7 +68,7 @@ struct CatalogDetailsView: View {
             .fixedSize(horizontal: false, vertical: true)
             HStack {
                 Spacer()
-                Button("Cancel", role: .cancel) { model.close() }
+                Button("Cancel") { model.close() }
                     .keyboardShortcut(.cancelAction)
                 Button("Install This Version") { model.installSelection() }
                     .keyboardShortcut(.defaultAction)
