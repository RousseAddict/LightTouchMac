NSView.displayLink(target:selector:) (macOS 14) drives every frame. On macOS 11 it's BigSurCompat's
CompatDisplayLink, a CVDisplayLink that sends step to the view on the main thread; it follows the window's screen
through followScreen, which NSView's link did by itself.

diff --git a/LightTouchMac/UI/DisplayView.swift b/LightTouchMac/UI/DisplayView.swift
index f9002d7e..2790a3bc 100644
--- a/LightTouchMac/UI/DisplayView.swift
+++ b/LightTouchMac/UI/DisplayView.swift
@@ -184,7 +184,13 @@ final class DisplayView: NSView {
     let homeButton = HomeButton()
     let attitudeIndicator = AttitudeIndicatorButton(frame: .zero)
     /// Steps the frames and the overlays while the view is in a window.
-    private(set) var displayLink: CADisplayLink?
+    private(set) var displayLink: CompatDisplayLink?
+    /// Big Sur port: a CVDisplayLink follows the screen it's given, where NSView's display link follows the window's.
+    @objc private func followScreen() {
+        guard let number = window?.screen?.deviceDescription[NSDeviceDescriptionKey("NSScreenNumber")] as? NSNumber
+        else { return }
+        displayLink?.setDisplay(number.uint32Value)
+    }
     /// The ring serial on screen, and its surface (captures read it).
     var shownSerial: UInt64 = 0
     var shownSurface: IOSurface?
@@ -360,13 +366,16 @@ final class DisplayView: NSView {
             object: nil
         )
         bezelPreferenceChanged()
-        let link = displayLink(target: self, selector: #selector(step))
+        let link = CompatDisplayLink(target: self, selector: #selector(step))
         // At the guest's refresh, not the display's: left alone a link runs at the display's highest rate, which
         // holds a ProMotion panel at 120 Hz and steps twice for each 60 Hz frame (issue 107).
         let hz = Float(DisplayRefresh.hz)
         link.preferredFrameRateRange = CompatFrameRateRange(minimum: min(30, hz), maximum: hz, preferred: hz)
         link.add(to: .main, forMode: .common)
         displayLink = link
+        followScreen()
+        NotificationCenter.default.addObserver(
+            self, selector: #selector(followScreen), name: NSWindow.didChangeScreenNotification, object: window)
         // Moving between displays can change the backing pixel scale.
         for name in [NSWindow.didChangeScreenNotification, NSWindow.didMoveNotification] {
             NotificationCenter.default.addObserver(self, selector: #selector(screenChanged), name: name, object: window)
