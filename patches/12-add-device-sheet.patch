The Add Device sheet on macOS 11. AddDeviceSummary parses a release day with CompatFormat (Date's ISO 8601
strategy is macOS 12), takes the mirror's host from URL.host (host() is macOS 13), and colors a feature's mark
green or tertiary without AnyShapeStyle (macOS 12). In AddDeviceView, a device's pick count is compatBadge (a
trailing count before macOS 12), Cancel has no role (macOS 12; Escape is its keyboard shortcut either way), and
sizingOptions (macOS 13) is set only where it exists: macOS 11's hosting controller already holds the window to the
view's minimum and lets it grow.

diff --git a/LightTouchMac/UI/AddDeviceSummary.swift b/LightTouchMac/UI/AddDeviceSummary.swift
index e8ba419f..cf29f0d1 100644
--- a/LightTouchMac/UI/AddDeviceSummary.swift
+++ b/LightTouchMac/UI/AddDeviceSummary.swift
@@ -85,13 +85,12 @@ struct AddDeviceSummary: View {
     }
 
     private func released(_ entry: FirmwareCatalog.Entry) -> String? {
-        entry.released.flatMap { try? Date($0, strategy: .iso8601.year().month().day()) }?
-            .compatFormatted(date: .long, time: .omitted)
+        entry.released.flatMap(CompatFormat.parseISO8601Day)?.compatFormatted(date: .long, time: .omitted)
     }
 
     /// Where the IPSW comes from: Apple, or the mirror's host (archive.org).
     private func source(_ entry: FirmwareCatalog.Entry) -> String? {
-        guard entry.bundled == nil, let host = entry.source.url?.host() else { return nil }
+        guard entry.bundled == nil, let host = entry.source.url?.host else { return nil }
         return host.hasSuffix("apple.com") ? "Apple" : host
     }
 
@@ -188,7 +187,7 @@ private struct FeatureCell: View {
                 .lineLimit(1)
             Spacer(minLength: 2)
