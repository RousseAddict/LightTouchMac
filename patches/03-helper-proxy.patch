URLSessionTask.delegate is macOS 12. The web proxy's session gets one delegate, UpstreamRouter
(add/LightTouchDevice/UpstreamRouter.swift), which hands each task's callbacks to the Upstream registered for it
before the task resumes.

diff --git a/LightTouchDevice/WebProxy.swift b/LightTouchDevice/WebProxy.swift
index 826d434a..7da3d450 100644
--- a/LightTouchDevice/WebProxy.swift
+++ b/LightTouchDevice/WebProxy.swift
@@ -119,7 +119,7 @@ final class WebProxy: @unchecked Sendable {
         egressReady = egress >= 0
         let queue = OperationQueue()
         queue.maxConcurrentOperationCount = 1
-        session = URLSession(configuration: configuration, delegate: nil, delegateQueue: queue)
+        session = URLSession(configuration: configuration, delegate: UpstreamRouter(), delegateQueue: queue)
         // The C helper's archive cache and gate files (64 slots of up to 2 MiB) are the URLCache's job now.
         let directory = config.deletingLastPathComponent()
         for name in (try? FileManager.default.contentsOfDirectory(atPath: directory.path)) ?? []
@@ -408,7 +408,7 @@ final class WebProxy: @unchecked Sendable {
         let upstream = Upstream(anchors: anchors, store: store)
         let task = session.dataTask(with: request)
         upstream.task = task
-        task.delegate = upstream
+        UpstreamRouter.route(task, to: upstream, in: session)
         task.resume()
         defer { task.cancel() }
         var started = false
@@ -466,7 +466,7 @@ final class WebProxy: @unchecked Sendable {
         let upstream = Upstream(anchors: anchors, store: false)
         let task = session.dataTask(with: request)
         upstream.task = task
-        task.delegate = upstream
+        UpstreamRouter.route(task, to: upstream, in: session)
         task.resume()
         defer { task.cancel() }
         var response: HTTPURLResponse?
